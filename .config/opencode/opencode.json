{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-agent-skills@0.6.5",
    "cc-safety-net@0.8.2",
    "@mohak34/opencode-notifier@0.2.1"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.2",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "build": {
      "model": "opencode-go/mimo-v2.5"
    }
  }
}
