#!/usr/bin/env python3
"""
Budget helper for claude-statusline.

    claude-budget <config_dir>            -> prints: month_pct day_pct month_spent today_spent daily_limit
    claude-budget <config_dir> --check    -> debug: fetch now, show parsed days and any error

Spend comes from Claude Code's own history (<config_dir>/projects/**/*.jsonl),
read via ccusage. Results are cached and refreshed in the background so the
status line never waits on it.

    daily limit = MONTHLY_LIMIT_USD / number of workdays in the month   (fixed, no rebalancing)
"""
import calendar, datetime, hashlib, json, os, shlex, subprocess, sys, time

# ------------------------------- config -------------------------------------
# Monthly budget in USD, from the environment: export CLAUDE_MONTHLY_LIMIT_USD=200 (e.g. in ~/.bashrc)
try:
    MONTHLY_LIMIT_USD = float(os.environ.get("CLAUDE_MONTHLY_LIMIT_USD", ""))
    if MONTHLY_LIMIT_USD <= 0:
        raise ValueError
except ValueError:
    MONTHLY_LIMIT_USD = None       # unset/invalid -> the budget segment is hidden
WORKDAYS = {0, 1, 2, 3, 4}         # Mon..Fri (0 = Monday)

# ccusage must be installed (npm i -g ccusage); there is no npx fallback.
# "claude daily" restricts the report to Claude Code (ignores Codex etc.).
CCUSAGE = os.environ.get("CCUSAGE_CMD") or "ccusage"
CCUSAGE_SUBCOMMAND = "claude daily"
CCUSAGE_EXTRA_ARGS = []            # e.g. ["--offline"] to skip fetching prices
CACHE_TTL = int(os.environ.get("CLAUDE_BUDGET_TTL", "120"))   # seconds
RUN_TIMEOUT = 120
# -----------------------------------------------------------------------------


def cache_path(config_dir):
    d = os.path.expanduser("~/.cache/claude-budget")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, hashlib.sha1(config_dir.encode()).hexdigest()[:12] + ".json")


def load_cache(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def norm_date(s):
    s = str(s)
    if len(s) == 8 and s.isdigit():
        return f"{s[:4]}-{s[4:6]}-{s[6:]}"
    return s[:10]


def parse_ccusage(text):
    """ccusage JSON -> {YYYY-MM-DD: cost_usd}. Tolerant of small format differences."""
    starts = [i for i in (text.find("{"), text.find("[")) if i >= 0]
    data = json.loads(text[min(starts):])
    rows = data.get("daily", data.get("data", [])) if isinstance(data, dict) else data
    days = {}
    for r in rows:
        date = r.get("date") or r.get("day")
        cost = r.get("totalCost", r.get("cost", r.get("total_cost")))
        if date is None or cost is None:
            continue
        k = norm_date(date)
        days[k] = days.get(k, 0.0) + float(cost)
    return days


def fetch(config_dir):
    since = datetime.date.today().replace(day=1).strftime("%Y%m%d")
    cmd = (shlex.split(CCUSAGE) + CCUSAGE_SUBCOMMAND.split()
           + ["--json", "--since", since] + CCUSAGE_EXTRA_ARGS)
    env = dict(os.environ, CLAUDE_CONFIG_DIR=config_dir, LOG_LEVEL="0")
    p = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=RUN_TIMEOUT)
    if p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} exited {p.returncode}: {p.stderr.strip()[:300]}")
    return parse_ccusage(p.stdout)


def refresh(config_dir, path):
    lock = path + ".lock"
    try:  # one refresher at a time; ignore locks older than 5 min
        if os.path.exists(lock) and time.time() - os.path.getmtime(lock) > 300:
            os.remove(lock)
        os.close(os.open(lock, os.O_CREAT | os.O_EXCL))
    except FileExistsError:
        return load_cache(path)
    try:
        cache = load_cache(path)
        try:
            cache.update(days=fetch(config_dir), fetched_at=time.time(),
                         month=datetime.date.today().isoformat()[:7], error=None)
        except Exception as e:
            cache["error"] = f"{type(e).__name__}: {e}"
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cache, f)
        os.replace(tmp, path)
        return cache
    finally:
        try:
            os.remove(lock)
        except OSError:
            pass


def numbers(days):
    today = datetime.date.today()
    mkey, tkey = today.isoformat()[:7], today.isoformat()
    month_spent = sum(v for k, v in days.items() if k.startswith(mkey))
    spent_today = days.get(tkey, 0.0)
    last = calendar.monthrange(today.year, today.month)[1]
    workdays = sum(1 for d in range(1, last + 1)
                   if datetime.date(today.year, today.month, d).weekday() in WORKDAYS) or 1
    daily_limit = MONTHLY_LIMIT_USD / workdays
    return (month_spent / MONTHLY_LIMIT_USD * 100, spent_today / daily_limit * 100,
            month_spent, spent_today, daily_limit)


def main():
    if len(sys.argv) < 2:
        sys.exit(2)
    config_dir = os.path.abspath(os.path.expanduser(sys.argv[1]))
    flag = sys.argv[2] if len(sys.argv) > 2 else ""
    if MONTHLY_LIMIT_USD is None:
        if flag == "--check":
            print("CLAUDE_MONTHLY_LIMIT_USD is not set (or not a positive number)")
        sys.exit(1 if flag == "--check" else 0)
    path = cache_path(config_dir)

    if flag in ("--refresh", "--check"):
        c = refresh(config_dir, path)
        if flag == "--check":
            print("config_dir:", config_dir)
            print("error:", c.get("error"))
            print("days this month:", json.dumps(c.get("days", {}), indent=2))
            if c.get("days") is not None:
                print("month% day% month$ today$ daily_limit$ ->",
                      " ".join(f"{v:.2f}" for v in numbers(c["days"])))
            sys.exit(1 if c.get("error") else 0)
        return

    c = load_cache(path)
    this_month = datetime.date.today().isoformat()[:7]
    if "days" not in c or c.get("month") != this_month:
        c = refresh(config_dir, path)          # nothing usable yet: wait for it once
    elif time.time() - c.get("fetched_at", 0) > CACHE_TTL:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), config_dir, "--refresh"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    if "days" not in c:
        return
    print("{:.1f} {:.1f} {:.2f} {:.2f} {:.2f}".format(*numbers(c["days"])))


if __name__ == "__main__":
    main()
