#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["textual>=8,<9"]
# ///
"""Search OpenCode sessions from its local storage and resume one with Enter."""
import json
import os
import shlex
import sqlite3
import sys
from datetime import datetime
from pathlib import Path

from rich.cells import cell_len
from rich.text import Text
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.suggester import Suggester
from textual.widgets import Footer, Input, OptionList
from textual.widgets.option_list import Option


MAX_CARDS = 150


def storage_dir():
    return Path(
        os.environ.get("OPENCODE_STORAGE_DIR")
        or Path.home() / ".local" / "share" / "opencode" / "storage"
    )


def load_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def message_data(root, session_id):
    messages = []
    message_dir = root / "message" / session_id
    for path in message_dir.glob("*.json"):
        message = load_json(path)
        if message:
            messages.append(message)
    return sorted(messages, key=lambda m: m.get("time", {}).get("created", 0))


def summary_title(value):
    """Return the title text of a summary value, which is a dict or a string."""
    if isinstance(value, dict):
        return value.get("title")
    if isinstance(value, str):
        return value
    return None


def message_meta(messages):
    texts = []
    cost = 0.0
    for message in messages:
        title = summary_title(message.get("summary"))
        if title:
            texts.append(str(title).strip())
        cost += message.get("cost") or 0
    return texts, cost


def project_name(session):
    directory = session.get("directory") or ""
    return Path(directory).name or session.get("projectID") or "global"


def database_sessions(root):
    """Load sessions from OpenCode 2.x's SQLite store, when present."""
    path = root.parent / "opencode.db"
    if not path.is_file():
        return {}
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        rows = db.execute(
            "SELECT id, project_id, directory, title, time_updated, cost "
            "FROM session_v2 ORDER BY time_updated DESC"
        ).fetchall()
        messages = {}
        for sid, text, created in db.execute(
            "SELECT session_id, data, time_created FROM session_message "
            "ORDER BY time_created"
        ):
            try:
                data = json.loads(text)
            except (TypeError, ValueError):
                continue
            messages.setdefault(sid, []).append(data)
        db.close()
    except (OSError, sqlite3.Error):
        return {}

    result = {}
    for sid, project_id, directory, title, updated, cost in rows:
        texts = []
        for message in messages.get(sid, ()):
            text = message.get("text") or summary_title(message.get("summary"))
            if text:
                texts.append(str(text).strip())
        result[sid] = {
            "id": sid,
            "cfg": root,
            "profile": Path(directory).name or project_id or "global",
            "project": directory or "",
            "last": updated or 0,
            "title": " ".join((title or (texts[0] if texts else "")).split()),
            "texts": texts,
            "count": len(messages.get(sid, ())),
            "cost": cost or 0.0,
            "name": "",
        }
        result[sid]["haystack"] = " ".join(
            [result[sid]["id"], result[sid]["profile"], result[sid]["project"],
             result[sid]["title"], *result[sid]["texts"]]
        ).lower()
        result[sid]["fields"] = {k: f(result[sid]) for k, f in FIELDS.items()}
    return result


def load_sessions(root):
    sessions = database_sessions(root)
    session_root = root / "session"
    for path in session_root.glob("*/*.json"):
        session = load_json(path)
        if not session:
            continue
        sid = session.get("id") or path.stem
        updated = (session.get("time") or {}).get("updated", 0)
        messages = message_data(root, sid)
        texts, cost = message_meta(messages)
        directory = session.get("directory") or ""
        title = session.get("title") or (texts[0] if texts else "")
        s = {
            "id": sid,
            "cfg": root,
            "profile": project_name(session),
            "project": directory,
            "last": updated,
            "title": " ".join(title.split()),
            "texts": texts,
            "count": len(messages),
            "cost": cost,
            "name": "",
        }
        s["haystack"] = " ".join(
            [s["id"], s["profile"], s["project"], s["title"], *s["texts"]]
        ).lower()
        s["fields"] = {k: f(s) for k, f in FIELDS.items()}
        if sid not in sessions:
            sessions[sid] = s
    return sorted(sessions.values(), key=lambda s: (s["last"], s["id"]), reverse=True)


FIELDS = {
    "dir": lambda s: s["project"].lower(),
    "title": lambda s: s["title"].lower(),
    "id": lambda s: s["id"].lower(),
    "text": lambda s: " ".join(s["texts"]).lower(),
    "date": lambda s: datetime.fromtimestamp(s["last"] / 1000).strftime("%Y-%m-%d %H:%M"),
}


def parse_query(query):
    """Split a query into (field, value) filters."""
    try:
        words = shlex.split(query.lower())
    except ValueError:
        words = query.lower().split()
    filters = []
    for word in words:
        key, _, value = word.partition(":")
        if value and key in FIELDS:
            if key == "dir" and value.startswith("~"):
                value = str(Path.home()).lower() + value[1:]
            filters.append((key, value))
        else:
            filters.append((None, word))
    return filters


def filter_sessions(sessions, query):
    filters = parse_query(query)
    return [
        s
        for s in sessions
        if all(v in (s["fields"][k] if k else s["haystack"]) for k, v in filters)
    ]


def fmt_time(ms):
    return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M")


def short_path(path):
    home = str(Path.home())
    return "~" + path[len(home):] if path.startswith(home) else path


def highlight(text, style, terms):
    out = Text(text, style=style, no_wrap=True, overflow="ellipsis")
    low = text.lower()
    for term in terms:
        i = low.find(term)
        while i != -1:
            out.stylize("bold underline magenta", i, i + len(term))
            i = low.find(term, i + 1)
    return out


def pad(text, width):
    return text + " " * max(0, width - cell_len(text))


def card(s, terms, width):
    day, clock = fmt_time(s["last"]).split(" ")
    card = highlight(s["title"] or "(no prompt)", "bold", terms)
    card.truncate(width, overflow="ellipsis")
    left = f"📆 {day}  🕐 {clock}  📁 "
    cost = pad(f"  💲 {s['cost']:.2f}" if s["cost"] else "", 11)
    right = f"🔑 {s['id']}  💬 {s['count']}{cost}"
    room = max(8, width - cell_len(left) - cell_len(right) - 2)
    folder = short_path(s["project"] or s["profile"])
    if cell_len(folder) > room:
        folder = "…" + folder[-(room - 1):]
    head, base = os.path.split(folder)
    card.append("\n\n" + left, style="yellow")
    card.append_text(highlight(head + "/" if head else "", "blue", terms))
    card.append_text(highlight(base, "bold green", terms))
    gap = max(2, width - cell_len(left) - cell_len(folder) - cell_len(right))
    card.append(" " * gap)
    card.append("🔑 ")
    card.append_text(highlight(s["id"], "cyan", terms))
    card.append(f"  💬 {s['count']}", style="dim")
    card.append(cost, style="bold yellow")
    return card


class KeySuggester(Suggester):
    def __init__(self, sessions):
        super().__init__(use_cache=False, case_sensitive=True)
        self.values = {
            "dir": list(dict.fromkeys(short_path(s["project"]) for s in sessions if s["project"])),
            "date": list(dict.fromkeys(fmt_time(s["last"])[:10] for s in sessions)),
            "id": [s["id"] for s in sessions],
        }

    async def get_suggestion(self, value):
        word = value.rsplit(" ", 1)[-1]
        if not word or '"' in word:
            return None
        before = value[: len(value) - len(word)]
        key, colon, typed = word.partition(":")
        key, typed = key.lower(), typed.lower()
        if not colon:
            for name in FIELDS:
                if name.startswith(key) and name != key:
                    return before + name + ":"
            return None
        for candidate in self.values.get(key, ()):
            if candidate.lower().startswith(typed) and candidate.lower() != typed:
                return before + key + ":" + candidate
        return None


class Sessions(App):
    CSS = """
    Input { margin: 0 0 1 0; }
    OptionList { height: 1fr; border: none; padding: 0 1; }
    OptionList > .option-list--option { padding: 0 1; }
    """
    BINDINGS = [
        ("escape", "quit", "Quit"),
        Binding("ctrl+c", "quit", "Quit", show=False, priority=True),
        Binding("tab", "complete", "Complete", priority=True),
        ("down", "move(1)", "Down"),
        ("up", "move(-1)", "Up"),
        ("pagedown", "page(1)", "Page down"),
        ("pageup", "page(-1)", "Page up"),
        ("ctrl+u", "clear", "Clear search"),
    ]

    def __init__(self, sessions):
        super().__init__()
        self.sessions = sessions
        self.by_id = {}
        self.drawn_width = 0
        self.pending = None

    def compose(self) -> ComposeResult:
        yield Input(suggester=KeySuggester(self.sessions), placeholder="Search text or key:value (dir: title: id: text: date:), Enter to resume")
        yield OptionList()
        yield Footer()

    def on_mount(self):
        self.query_one(OptionList).can_focus = False
        self.refill("")

    def on_resize(self):
        if self.size.width != self.drawn_width:
            self.refill(self.query_one(Input).value)

    def refill(self, query):
        terms = [v for _, v in parse_query(query)]
        found = filter_sessions(self.sessions, query)
        rows = found[:MAX_CARDS]
        self.drawn_width = self.size.width
        options = []
        self.by_id = {}
        for s in rows:
            self.by_id[s["id"]] = s
            options += [Option(card(s, terms, max(20, self.size.width - 8)), id=s["id"]), None]
        listing = self.query_one(OptionList)
        listing.clear_options()
        listing.add_options(options)
        if rows:
            listing.highlighted = 0
        more = f", first {MAX_CARDS} shown" if len(found) > MAX_CARDS else ""
        self.sub_title = f"{len(found)}/{len(self.sessions)} sessions{more}"

    def current(self):
        listing = self.query_one(OptionList)
        if listing.highlighted is None:
            return None
        return self.by_id.get(listing.get_option_at_index(listing.highlighted).id)

    def on_input_changed(self, event):
        if self.pending:
            self.pending.stop()
        self.pending = self.set_timer(0.08, lambda: self.refill(event.value))

    def on_input_submitted(self, event):
        if self.pending:
            self.pending.stop()
            self.pending = None
            self.refill(event.value)
        s = self.current()
        if s:
            self.exit(s)

    def action_move(self, step):
        listing = self.query_one(OptionList)
        listing.action_cursor_down() if step > 0 else listing.action_cursor_up()

    def action_page(self, step):
        listing = self.query_one(OptionList)
        listing.action_page_down() if step > 0 else listing.action_page_up()

    def action_complete(self):
        self.query_one(Input).action_cursor_right()

    def action_clear(self):
        self.query_one(Input).value = ""


def main():
    root = storage_dir()
    if not (root / "session").is_dir():
        sys.exit(f"no opencode session storage found: {root}")
    sessions = load_sessions(root)
    if not sessions:
        sys.exit("no sessions found")
    app = Sessions(sessions)
    app.title = "OpenCode sessions"
    choice = app.run()
    if not choice:
        return
    directory = choice["project"]
    if directory and os.path.isdir(directory):
        os.chdir(directory)
    os.execvp("opencode", ["opencode", "-s", choice["id"]])


if __name__ == "__main__":
    main()
